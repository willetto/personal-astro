---
import Text from "@/components/foundations/elements/Text.astro";
import ChevronRight from "@/components/foundations/icons/ChevronRight.astro";

interface AnnotationEntry {
  slug: string;
  data: {
    title: string;
    description: string;
    author: string;
    mediaType: 'book' | 'film' | 'album' | 'article' | 'podcast' | 'other';
    coverImage: { url: string; alt: string };
    pubDate: Date;
    tags?: string[];
  };
}

const { entry } = Astro.props as { entry: AnnotationEntry };

const url = `/annotations/${entry.slug}`;
const { title, description, author, mediaType, coverImage, pubDate } = entry.data;

const pubDateFormatted = new Date(pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});

const mediaTypeLabel: Record<string, string> = {
  book: "Book",
  film: "Film",
  album: "Album",
  article: "Article",
  podcast: "Podcast",
  other: "Media",
};
---

<div
  class="AnnotationCard relative overflow-hidden group flex h-full justify-between flex-col gap-12 bg-base-100 transition-all md:min-h-[100px] cursor-pointer shadow rounded-(--card-radius) p-(--card-padding) [--card-padding:--spacing(2)] [--card-radius:var(--radius-2xl)] hover:shadow-xl duration-500 border brand-border-color"
>
  <a href={url} title={title} class="absolute inset-0 z-10"></a>
  <div>
    {
      coverImage?.url && (
        <img
          src={coverImage.url}
          alt={coverImage.alt || title}
          width="800"
          height="800"
          loading="lazy"
          class="object-cover object-center aspect-12/9 rounded-[calc(var(--card-radius)-var(--card-padding))]"
        />
      )
    }
    <div class="mt-3 px-2 annotation-card-content">
      <div class="flex items-center gap-2">
        <span class="annotation-media-badge inline-block text-xs font-medium uppercase tracking-wide px-2 py-0.5 rounded-full border">
          {mediaTypeLabel[mediaType] || "Media"}
        </span>
        <Text
          tag="p"
          variant="textXS"
          class="uppercase annotation-card-date"
        >
          {pubDateFormatted}
        </Text>
      </div>
      <Text
        tag="h3"
        variant="textLG"
        class="mt-2 font-medium annotation-card-title"
      >
        {title}
      </Text>
      <Text
        tag="p"
        variant="textXS"
        class="mt-0.5 annotation-card-author brand-text-color"
      >
        {author}
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="mt-2 brand-text-color text-balance"
      >
        {description}
      </Text>
    </div>
  </div>
  <div class="px-2 pb-2">
    <Text
      tag="p"
      variant="textSM"
      class="flex items-center font-medium gap-2 brand-heading-color"
    >
      Read annotations
      <ChevronRight
        size="sm"
        class="duration-300 easy-out-in group-hover:translate-x-2"
      />
    </Text>
  </div>
</div>

<style>
  .annotation-card-content {
    .annotation-card-date {
      color: var(--color-base-400);
    }
    .annotation-card-title {
      color: var(--color-tw-green);
    }
    .annotation-card-author {
      color: var(--color-base-400);
      font-style: italic;
    }
  }

  .annotation-media-badge {
    color: var(--color-teal-700);
    border-color: var(--color-teal-300);
    background-color: light-dark(var(--color-teal-50), var(--color-teal-950));
  }
</style>
