---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/foundations/elements/Text.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Frontmatter {
  title: string;
  description: string;
  author: string;
  mediaType: 'book' | 'film' | 'album' | 'article' | 'podcast' | 'other';
  coverImage: { url: string; alt: string };
  pubDate: Date;
  tags?: string[];
}

interface Props {
  frontmatter: Frontmatter;
  headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2);

const pubDateFormatted = new Date(frontmatter.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});

const mediaTypeLabel: Record<string, string> = {
  book: "Book",
  film: "Film",
  album: "Album",
  article: "Article",
  podcast: "Podcast",
  other: "Media",
};
---

<BaseLayout>
  <!-- Page Header -->
  <section>
    <Wrapper variant="standard" class="py-32">
      <div class="flex items-center gap-3 mb-6">
        <Text
          tag="a"
          href="/annotations"
          variant="textXS"
          class="uppercase font-medium text-base-500 hover:text-teal-700 transition-colors"
        >
          ← Annotations
        </Text>
        <span class="text-base-300" aria-hidden="true">·</span>
        <span class="annotation-media-badge-lg">
          {mediaTypeLabel[frontmatter.mediaType] || "Media"}
        </span>
      </div>

      <Text
        tag="h1"
        variant="display2XL"
        data-aos="fade-up"
        data-aos-duration="1000"
        class="font-semibold font-display brand-heading-color text-balance uppercase"
      >
        {frontmatter.title}
      </Text>

      <div class="mt-3 flex items-center gap-4">
        <Text tag="p" variant="textSM" class="brand-text-color italic">
          {frontmatter.author}
        </Text>
        <span class="text-base-300" aria-hidden="true">·</span>
        <Text tag="p" variant="textSM" class="brand-text-color">
          <time datetime={new Date(frontmatter.pubDate).toISOString()}>
            {pubDateFormatted}
          </time>
        </Text>
      </div>

      <Text
        tag="p"
        variant="textBase"
        data-aos="fade-up"
        data-aos-duration="1500"
        class="mt-4 brand-text-color max-w-xl"
      >
        {frontmatter.description}
      </Text>

      {
        frontmatter.coverImage?.url && (
          <img
            width="1200"
            height="675"
            alt={frontmatter.coverImage.alt}
            src={frontmatter.coverImage.url}
            loading="eager"
            class="size-full object-cover object-center max-h-100 mt-8 rounded-2xl"
          />
        )
      }
    </Wrapper>
  </section>

  <!-- Content + TOC -->
  <section>
    <Wrapper variant="standard" class="py-12 border-t brand-border-color">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[240px_1fr] items-start">

        <!-- TOC Sidebar -->
        <aside class="lg:sticky lg:top-[calc(var(--nav-height,0px)+2rem)]">
          {
            tocHeadings.length > 0 && (
              <nav aria-label="Table of contents" class="toc-nav">
                <Text
                  tag="p"
                  variant="textXS"
                  class="uppercase font-medium text-base-400 tracking-widest mb-3"
                >
                  Contents
                </Text>
                <ol class="toc-list space-y-1">
                  {tocHeadings.map((h) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        class="toc-link"
                        data-toc-target={h.slug}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="mt-8 pt-6 border-t brand-border-color">
                <Text
                  tag="p"
                  variant="textXS"
                  class="uppercase font-medium text-base-400 tracking-widest mb-3"
                >
                  Tags
                </Text>
                <div class="flex flex-wrap gap-2">
                  {frontmatter.tags.map((tag) => (
                    <span class="annotation-tag">{tag}</span>
                  ))}
                </div>
              </div>
            )
          }
        </aside>

        <!-- Prose Content -->
        <div class="annotation-prose-container">
          <Wrapper
            variant="prose"
            class="prose-h2:text-teal-800 prose-h3:text-(--color-tw-orange) prose-h4:text-yellow-700 annotation-prose"
          >
            <slot />
          </Wrapper>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>

<style>
  .annotation-media-badge-lg {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--color-teal-300);
    color: var(--color-teal-700);
    background-color: light-dark(var(--color-teal-50), var(--color-teal-950));
  }

  /* TOC */
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-link {
    display: block;
    font-size: 0.8rem;
    color: var(--color-base-500);
    padding: 0.25rem 0;
    border-bottom: 1px dashed transparent;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
    line-height: 1.4;
  }

  .toc-link:hover,
  .toc-link.active {
    color: var(--color-teal-700);
    border-bottom-color: var(--color-teal-400);
  }

  /* Tags */
  .annotation-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: capitalize;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background-color: light-dark(var(--color-base-100), var(--color-base-800));
    color: var(--color-base-500);
    border: 1px solid light-dark(var(--color-base-200), var(--color-base-700));
  }

  /* ---- Collapsible sections ---- */
  :global(.annotation-section) {
    border: 1px solid light-dark(var(--color-base-200), var(--color-base-700));
    border-radius: var(--radius-xl);
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  :global(.annotation-summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-size: 1.1rem;
    font-weight: 600;
    color: light-dark(var(--color-teal-800), var(--color-teal-300));
    background-color: light-dark(var(--color-teal-50), var(--color-teal-950));
    transition: background-color 0.2s ease;
    user-select: none;
  }

  :global(.annotation-summary::-webkit-details-marker) {
    display: none;
  }

  :global(.annotation-summary::marker) {
    display: none;
  }

  :global(.annotation-section[open] .annotation-summary) {
    background-color: light-dark(var(--color-teal-100), var(--color-teal-900));
    border-bottom: 1px solid light-dark(var(--color-teal-200), var(--color-teal-800));
  }

  :global(.annotation-summary-left) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  :global(.annotation-summary-chevron) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--color-teal-600);
    transition: transform 0.3s ease;
  }

  :global(.annotation-section[open] .annotation-summary-chevron) {
    transform: rotate(90deg);
  }

  :global(.annotation-summary-text) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.annotation-summary-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* Copy-link button */
  :global(.copy-link-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-md);
    border: 1px solid light-dark(var(--color-teal-300), var(--color-teal-700));
    background: light-dark(white, var(--color-base-900));
    color: var(--color-teal-600);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease, background-color 0.2s ease;
    font-size: 0.75rem;
    position: relative;
  }

  :global(.annotation-summary:hover .copy-link-btn),
  :global(.copy-link-btn:focus-visible) {
    opacity: 1;
  }

  :global(.copy-link-btn:hover) {
    background-color: light-dark(var(--color-teal-50), var(--color-teal-950));
  }

  :global(.copy-link-btn svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* Tooltip */
  :global(.copy-link-btn::after) {
    content: "Copied!";
    position: absolute;
    bottom: calc(100% + 0.4rem);
    right: 0;
    background: light-dark(var(--color-base-800), var(--color-base-100));
    color: light-dark(var(--color-base-100), var(--color-base-800));
    font-size: 0.65rem;
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  :global(.copy-link-btn.copied::after) {
    opacity: 1;
  }

  /* Section content animation (grid trick) */
  :global(.details-content) {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease, opacity 0.3s ease;
    opacity: 0;
  }

  :global(.annotation-section[open] .details-content) {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  :global(.details-content > .details-inner) {
    overflow: hidden;
    padding: 0 1.25rem 1.25rem;
  }
</style>

<script>
  function initAnnotations() {
    const proseEl = document.querySelector<HTMLElement>(".annotation-prose");
    if (!proseEl) return;

    const h2s = [...proseEl.querySelectorAll<HTMLHeadingElement>("h2")];
    if (!h2s.length) return;

    // Collect sections: each h2 + its following siblings until the next h2
    type Section = { h2: HTMLHeadingElement; siblings: Element[] };
    const sections: Section[] = h2s.map((h2, i) => {
      const nextH2 = h2s[i + 1];
      const siblings: Element[] = [];
      let el = h2.nextElementSibling;
      while (el && el !== nextH2) {
        siblings.push(el);
        el = el.nextElementSibling;
      }
      return { h2, siblings };
    });

    // Build and insert collapsible details
    sections.forEach(({ h2, siblings }) => {
      const id = h2.id || h2.textContent!.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

      const details = document.createElement("details");
      details.className = "annotation-section not-prose";
      details.id = id;
      details.open = true;

      // Build summary
      const summary = document.createElement("summary");
      summary.className = "annotation-summary";

      // Left group: chevron + text
      const leftGroup = document.createElement("span");
      leftGroup.className = "annotation-summary-left";

      const chevronSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      chevronSvg.setAttribute("viewBox", "0 0 24 24");
      chevronSvg.setAttribute("fill", "none");
      chevronSvg.setAttribute("stroke", "currentColor");
      chevronSvg.setAttribute("stroke-width", "2");
      chevronSvg.setAttribute("stroke-linecap", "round");
      chevronSvg.setAttribute("stroke-linejoin", "round");
      chevronSvg.classList.add("annotation-summary-chevron");
      const chevronPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
      chevronPath.setAttribute("d", "M9 18l6-6-6-6");
      chevronSvg.appendChild(chevronPath);

      const textSpan = document.createElement("span");
      textSpan.className = "annotation-summary-text";
      textSpan.innerHTML = h2.innerHTML;

      leftGroup.appendChild(chevronSvg);
      leftGroup.appendChild(textSpan);

      // Right group: copy button
      const actionsGroup = document.createElement("span");
      actionsGroup.className = "annotation-summary-actions";

      const copyBtn = document.createElement("button");
      copyBtn.className = "copy-link-btn";
      copyBtn.setAttribute("aria-label", "Copy link to section");
      copyBtn.setAttribute("title", "Copy link to section");
      copyBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = `${location.origin}${location.pathname}#${id}`;
        navigator.clipboard.writeText(url).then(() => {
          copyBtn.classList.add("copied");
          setTimeout(() => copyBtn.classList.remove("copied"), 2000);
        });
      });

      const linkSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      linkSvg.setAttribute("viewBox", "0 0 24 24");
      linkSvg.setAttribute("fill", "none");
      linkSvg.setAttribute("stroke", "currentColor");
      linkSvg.setAttribute("stroke-width", "2");
      linkSvg.setAttribute("stroke-linecap", "round");
      linkSvg.setAttribute("stroke-linejoin", "round");
      const linkPath1 = document.createElementNS("http://www.w3.org/2000/svg", "path");
      linkPath1.setAttribute("d", "M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71");
      const linkPath2 = document.createElementNS("http://www.w3.org/2000/svg", "path");
      linkPath2.setAttribute("d", "M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71");
      linkSvg.appendChild(linkPath1);
      linkSvg.appendChild(linkPath2);
      copyBtn.appendChild(linkSvg);
      actionsGroup.appendChild(copyBtn);

      summary.appendChild(leftGroup);
      summary.appendChild(actionsGroup);
      details.appendChild(summary);

      // Content wrapper with animation
      const contentDiv = document.createElement("div");
      contentDiv.className = "details-content";
      const innerDiv = document.createElement("div");
      innerDiv.className = "details-inner";
      siblings.forEach((s) => innerDiv.appendChild(s.cloneNode(true)));
      contentDiv.appendChild(innerDiv);
      details.appendChild(contentDiv);

      // Replace original h2 + siblings
      h2.parentNode!.insertBefore(details, h2);
      h2.remove();
      siblings.forEach((s) => s.remove());
    });

    // Handle hash on load: open matching section and scroll to it
    function openSectionForHash(hash: string) {
      if (!hash) return;
      const id = hash.replace("#", "");
      const target = document.getElementById(id) as HTMLDetailsElement | null;
      if (target && target.tagName === "DETAILS") {
        target.open = true;
        setTimeout(() => target.scrollIntoView({ behavior: "smooth", block: "start" }), 100);
      }
    }

    if (location.hash) {
      openSectionForHash(location.hash);
    }

    // TOC link clicks: open section before navigation
    document.querySelectorAll<HTMLAnchorElement>("[data-toc-target]").forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.dataset.tocTarget!;
        const target = document.getElementById(targetId) as HTMLDetailsElement | null;
        if (target && target.tagName === "DETAILS") {
          target.open = true;
          setTimeout(() => {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            history.pushState(null, "", `#${targetId}`);
          }, 50);
        }
      });
    });

    // Active TOC highlight on scroll
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          const link = document.querySelector<HTMLAnchorElement>(`.toc-link[data-toc-target="${id}"]`);
          if (link) {
            link.classList.toggle("active", entry.isIntersecting);
          }
        });
      },
      { rootMargin: "-10% 0px -80% 0px" }
    );

    document.querySelectorAll<HTMLElement>(".annotation-section").forEach((el) => {
      observer.observe(el);
    });
  }

  document.addEventListener("DOMContentLoaded", initAnnotations);
</script>
